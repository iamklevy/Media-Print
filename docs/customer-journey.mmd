subgraph S3["3 - CONFIGURE AND PRICE"]
  direction TB
  PRICER["Open price calculator
on the product card"]
  SIZE["Choose size / variant"]
  OPTS["Toggle printing
or finishing option"]
  QTY["Set quantity"]
