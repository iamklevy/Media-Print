flowchart TB

subgraph S1["1 - DISCOVER"]
  direction LR
  E1(["Google search
Arabic or English"])
  E2(["Facebook page"])
  E3(["Referral / direct"])
  HOME["HOME
hero - benefits - clients
process - sectors"]
