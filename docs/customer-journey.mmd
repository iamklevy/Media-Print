end

BEST --> PRICER
CAT --> PRICER
STK --> ASK
SRV --> ASK

D2{"How do they
want to proceed?"}
MOQ -- "yes" --> D2

subgraph S4["4 - CONVERT"]
  direction LR
  SPEC[/"WhatsApp - full spec
prefilled from calculator"/]
  ASK["Quote form
name - phone - product - qty"]
  BOOK["BOOK A MEETING"]
  CALL(["Phone or email"])
  MODE{"Meeting
location"}
  M1["Online call"]
  M2["We visit
customer office"]
  M3["Customer visits
our office, Mohandessin"]
  BOOK --> MODE
  MODE --> M1
  MODE --> M2
  MODE --> M3
end

D2 -- "fastest" --> SPEC
D2 -- "wants a formal quote" --> ASK
D2 -- "wants to meet" --> BOOK
D2 -- "prefers to talk" --> CALL

WA[["All routes arrive on one
WhatsApp sales line
01005750973"]]
SPEC --> WA
ASK --> WA
M1 --> WA
M2 --> WA
M3 --> WA
CALL --> WA

subgraph S5["5 - SALES AND APPROVAL"]
  direction TB
  CONF["Sales confirms spec,
price and lead time"]
  ART["Artwork prepared
or customer file checked"]
  SAMP["Physical sample produced"]
  D3{"Customer
approves sample?"}
  REV["Revise artwork
or material"]
  CONF --> ART --> SAMP --> D3
  D3 -- "no" --> REV
  REV --> ART
end

WA --> CONF

subgraph S6["6 - PRODUCE AND DELIVER"]
  direction LR
  PROD["Production run
print - finish - cut"]
  SHIP["Shipped to any governorate
or Arab country"]
  DONE(["Order delivered"])
  PROD --> SHIP --> DONE
end

D3 -- "yes" --> PROD
DONE -- "reorder" --> BEST

