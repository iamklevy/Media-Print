classDef entry  fill:#FDF1E7,stroke:#DD6320,stroke-width:2px,color:#16130F
classDef page   fill:#FFFDFA,stroke:#B3480F,stroke-width:1.5px,color:#16130F
classDef sys    fill:#F7F2EA,stroke:#6E645A,stroke-width:1.5px,color:#16130F
classDef auto   fill:#16130F,stroke:#16130F,color:#FFFDFA
classDef choice fill:#FFFFFF,stroke:#DD6320,stroke-width:2px,color:#B3480F
classDef done   fill:#2F6B4F,stroke:#2F6B4F,color:#FFFFFF

class E1,E2,E3,CALL entry
class HOME,BEST,CAT,STK,SRV,PRICER,SIZE,OPTS,QTY,ASK,BOOK,M1,M2,M3,CONF,ART,SAMP,REV,PROD,SHIP page
class WARN,SPEC,NOTE sys
class CALC,WA auto
class D1,D2,D3,MOQ,MODE choice
class DONE done
